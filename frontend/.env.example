# Development example. All three REACT_APP values are browser-public.
# Production build requires explicit public HTTPS API and Supabase URLs,
# and a Supabase publishable/anon key. Only these three REACT_APP names are allowed.
# Never add Gemini/USDA keys, service-role keys, passwords or database credentials.
REACT_APP_API_URL=http://127.0.0.1:8000

# Public Supabase project settings ONLY. Never add a service-role key here.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
