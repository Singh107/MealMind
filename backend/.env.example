# Server only. Copy to backend/.env; never put secrets in REACT_APP_* variables.
GEMINI_API_KEY=
# Explicit server-side default; use a model listed for your key with generateContent support.
# Model listing confirms compatibility, not current generation capacity. Restart after changes.
GEMINI_MODEL=gemini-3.1-flash-lite
GENERATION_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=4096
# Optional in development; required by production startup validation.
# Provider failures still return unavailable nutrition rather than invented values.
USDA_API_KEY=
NUTRITION_TIMEOUT_SECONDS=10
NUTRITION_CACHE_TTL_SECONDS=86400
NUTRITION_CACHE_MAX_ENTRIES=256
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# User-triggered repair: at most two proposals within one total time budget.
MAX_REPAIR_ATTEMPTS=2
REPAIR_TIMEOUT_SECONDS=100

# Explicit opt-in only. Production rejects mock mode. Never deploy with both enabled.
MEALMIND_ENVIRONMENT=development
MEALMIND_DEV_MOCK_AI=false

# Public Supabase project configuration; caller JWT and RLS authorize user operations.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Production requires explicit HTTPS CORS origins, public hosts and all provider/account values.
# Change CORS_ORIGINS above before setting MEALMIND_ENVIRONMENT=production.
ALLOWED_HOSTS=localhost,127.0.0.1
EXPENSIVE_REQUESTS_PER_MINUTE=10
GLOBAL_EXPENSIVE_PER_MINUTE=60
GLOBAL_EXPENSIVE_PER_DAY=500
EXPENSIVE_CONCURRENCY=4
